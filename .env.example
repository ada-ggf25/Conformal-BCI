# Copy this file to .env and fill in real values.

# MongoDB connection string
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/<db>?authSource=<db>

# Name of the database inside the cluster that holds the Atlas functional dataset
MONGODB_DATABASE=<database_name>

# SSH tunnel, required when MongoDB is on a remote host
# Leave blank to connect directly without a tunnel
SSH_HOST=<remote_host_ip>
SSH_PORT=22
SSH_USERNAME=<ssh_user>
SSH_PASSWORD=<ssh_password>
